# XgirlfriendGPT Environment Configuration
# Copy this file to .env and customize for your deployment

# =============================================================================
# LLM Provider Configuration
# =============================================================================
# Provider: auto, ollama, vllm, together, openai, mock
LLM_PROVIDER=ollama

# Ollama/OpenAI-compatible API base URL
LLM_BASE_URL=http://localhost:11434/v1

# API Key for remote providers (Together, OpenAI, etc.)
# For local Ollama, leave empty
LLM_API_KEY=

# Default model identifier (must be available in your LLM provider)
# Examples: R4C3R/qwen3-8b-heretic:q8_0, llama3.3:70b, mistral-nemo:12b
DEFAULT_MODEL=R4C3R/qwen3-8b-heretic:q8_0

# =============================================================================
# Vector Database & Memory Settings
# =============================================================================
# Qdrant host: local path (./data/qdrant_db) or remote (host:port)
QDRANT_HOST=./data/qdrant_db

# Qdrant collection name for companion memories
QDRANT_COLLECTION=companion_memories

# =============================================================================
# Security & Authentication
# =============================================================================
# JWT Secret Key - GENERATE A STRONG KEY FOR PRODUCTION!
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars

# =============================================================================
# Media & Voice Pipeline URLs (Optional - for external services)
# =============================================================================
# IMAGE_GEN_API_URL=http://localhost:8001/v1/generate
# TTS_API_URL=http://localhost:8002/v1/tts

# =============================================================================
# Telephony / SMS Settings (Twilio - Optional)
# =============================================================================
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# =============================================================================
# Application Settings
# =============================================================================
# Environment: development, staging, production
ENV=development

# Application name
APP_NAME=XgirlfriendGPT